# ====== Secrets (required) ======
TRAVELPAYOUTS_TOKEN=your_travelpayouts_api_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ====== Tuning (optional, GitHub Variables) ======
# Currency: cny / aed / usd / eur / gbp / rub / hkd / twd / krw / jpy / sgd / myr / thb / inr
CURRENCY=cny
ORIGINS=DXB

# Alert thresholds
ROLLING_WINDOW_DAYS=14
ROLLING_DROP_PCT=0.20
TARGET_MARGIN_PCT=0.10

# Search window
MONTHS_AHEAD=6
MAX_NIGHTS=21

# Watchlist (extra routes shown every day, even if not a deal)
WATCHLIST=PEK,PVG,HKG

# Set to "true" to send a "still alive" note when nothing triggered
HEARTBEAT=true

# Set to "true" to scan + record prices but NOT send any Telegram messages
MUTE=false

# Set to "false" to skip the broad fallback API call for empty routes
BROAD_FALLBACK=true